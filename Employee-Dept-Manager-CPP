#include <iostream>
#include <string>

using namespace std;

// 1. First Struct: Department details | تفاصيل القسم
struct Department {
    string deptName; // Name of the department | اسم القسم
    int floor;       // Floor location | رقم الطابق
};

// 2. Second Struct: Employee details | تفاصيل الموظف
struct Employee {
    string name;     // Employee full name | اسم الموظف
    int id;          // Work ID number | الرقم الوظيفي
    Department dept; // Nesting: linking Department to Employee | ربط القسم بالموظف
};

int main() {
    Employee emp; // Create an instance | إنشاء كائن للموظف

    cout << "--- Company Staff Entry System ---\n";

    // Input Employee info | إدخال بيانات الموظف
    cout << "Employee Name: ";
    getline(cin, emp.name);
    cout << "Employee ID: ";
    cin >> emp.id;

    // Input Department info via Employee object | إدخال بيانات القسم من خلال الموظف
    cout << "Department Name: ";
    cin.ignore(); // Clean buffer for getline | تنظيف الذاكرة المؤقتة
    getline(cin, emp.dept.deptName);
    
    cout << "Floor Number: ";
    cin >> emp.dept.floor;

    // Output Data | عرض البيانات النهائية
    cout << "\n--- [ Employee Profile Summary ] ---\n";
    cout << "Full Name: " << emp.name << endl;
    cout << "Staff ID:  " << emp.id << endl;
    
    // Accessing nested data using dot (.) twice | الوصول للبيانات المتداخلة
    cout << "Work Unit: " << emp.dept.deptName 
         << " (Located at Floor: " << emp.dept.floor << ")" << endl;

    cout << "\n------------------------------------" << endl;
    cout << "System updated successfully!" << endl;

    return 0;
}

