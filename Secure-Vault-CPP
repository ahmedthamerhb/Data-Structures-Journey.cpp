#include <iostream>
#include <string>

using namespace std;

// 1. Defining the Credential Structure | تعريف هيكل بيانات الاعتماد
struct Credential {
    string platformName;   // e.g., GitHub, Facebook, LinkedIn | اسم المنصة
    string username;       // User login name | اسم المستخدم
    string encryptedPass;  // The password after "encryption" | كلمة المرور بعد التشفير
};

// 2. Simple Encryption Logic (Caesar Cipher style) | منطق تشفير بسيط (تحريك الحروف)
string encrypt(string pass) {
    for(int i = 0; i < pass.length(); i++) {
        pass[i] = pass[i] + 2; // Shift characters by 2 | زحف الحروف بمقدار 2
    }
    return pass;
}

int main() {
    // 3. Creating an instance | إنشاء نسخة
    Credential myAccount;

    // 4. Assigning Data | إسناد البيانات
    myAccount.platformName = "LinkedIn";
    myAccount.username = "ahmed_thamer";
    
    string rawPassword = "Password123"; 
    myAccount.encryptedPass = encrypt(rawPassword); // Secure it! | تشفيرها فوراً

    // 5. Displaying the Result | عرض النتيجة
    cout << "--- Secure Credential Vault ---" << endl;
    cout << "Platform: " << myAccount.platformName << endl;
    cout << "Username: " << myAccount.username << endl;
    
    cout << "-------------------------------" << endl;
    cout << "Stored Password (Encrypted): " << myAccount.encryptedPass << endl;
    cout << "NOTICE: Raw password is never stored in plain text." << endl;

    return 0;
}

